# Copy to ~/.config/stremio-jellyfin-addon/env (or set ENV_FILE). Real environment variables win.
# Paths and addresses only. Never put the API key or the token itself in this file.

# LAN address of the machine that runs the add-on (required for Stremio on another device)
BIND_ADDRESS=192.0.2.20
PORT=8796

JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_KEY_FILE=/home/you/.config/stremio-jellyfin-addon/jellyfin-key
TOKEN_FILE=/home/you/.config/stremio-jellyfin-addon/token

REFRESH_SECONDS=600
ADDON_NAME=Jellyfin (self-hosted)
